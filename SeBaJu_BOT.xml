        <!--===================================================================
        BASE BODY — free-floating anchor (no torso_pitch joint)
        ─────────────────────────────────────────────────────────────────────
        The entire chassis is one rigid body, just like Ascento's pendulum
        body.  The free joint gives 6-DOF motion in the world.
        mass=2.5 kg represents the combined chassis + electronics.
        pos="0 0 0.371" matches keyframe height.
        ===================================================================-->
        <body name="base" pos="0 0 0.371">
            <joint name="root" type="free"/>
            <!-- CoM lowered: from z=0.06 to z=0.00 (base pivot level).
                 Torso geom and IMU site shifted down commensurately. -->
            <inertial pos="0 0 0.00" mass="2.5" diaginertia="0.02 0.02 0.01"/>

            <!-- Torso cylinder — axis along Y, radius 10 cm, half-length 7 cm 
            Shifted down 0.06 m: was pos="0 0 0.06", now pos="0 0 0.00"
            Strickly testing: collusion >> contype="0" conaffinity="0" in Torso, right and left thigh and knee-->
            <geom type="cylinder" size="0.10 0.07"
                  pos="0.0 0 0.00"
                  quat="0.7071 0.7071 0 0"
                  material="torso_mat"
                  contype="1" conaffinity="1"/>

            <!-- IMU site at top of torso 
            at top of torso cylinder (half-length 0.07 m above pivot)-->
            <site name="imu_site" pos="0.0 0 0.07" size="0.01" rgba="1 1 0 1" euler="0 0 0"/>

            <!--===============================================================
            LEFT LEG
            ─────────────────────────────────────────────────────────────────
            axis="0 1 0" + ref=−0.60 → at rest, thigh tips 34° backward (−X).
            axis="0 1 0" + ref=−1.20 → at rest, shank sweeps 69° forward-down.
            thigh → absolute shank angle = +0.60 rad from vertical.
              Wheel X-offset cancels thigh X-offset → wheel under CoM. ✓

            Knee range "0.10 1.571":
              +0.10 rad =  +5.7° min bend  (prevents singular full extension)
              +1.571 rad = +90°  max bend  (hard anatomical limit)
              ref=+1.20 sits comfortably inside range.

            Thigh & shank geom quat="1 0 0 0" (identity): capsule long-axis
              is local Z, pointing down (pos="0 0 -0.11" offsets centre).
              The previous quat="0 1 0 0" (180° about X) was redundant —
              flipping Z→−Z then offsetting −Z gave the same world position
              but introduced a spurious 180° body rotation that confused the
              joint-frame interpretation.

            stiffness=50 on knee: passive spring resisting straightening past
            ref=+1.20.  Mirrors Ascento's torsion springs at inner joints.
            ===============================================================-->
            <body name="left_leg" pos="0 0.09 0">
                <!--Changed ref to -ve to align with -X axis coordinate
                expanded range as ref=-0.60 increased to -0.785 ("-0.96 0.96 >> -1.20 0.40")-->
                <joint name="left_hip" type="hinge"
                       axis="0 1 0"
                       range="-1.20 0.40"
                       ref="-0.785"
                       damping="1.5" frictionloss="0.05"/>
                  <!--changed quat to 1 0 0 0 ~ no rotation; ref provides required orientation-->
                <geom name="left_thigh" type="capsule"
                      pos="0 0 -0.11"
                      size="0.022 0.11"
                      quat="1 0 0 0"
                      material="thigh_mat"
                      mass="0.20" contype="1" conaffinity="1"/>

                <body name="left_shank" pos="0 0 -0.22">
                      <!--changed to +ve with respect to -ve parent body thigh ref, ensuring shank bends forward
                      and maintains wheel-under-CoM constraint.
                      Expanded range as ref=1.20 increased to 1.571 ("0.10 1.571 >> 0.20 1.571")
                      Strickly testing: Knee range moved 0.20 1.571 >> 0.20 1.80, Stiffness 50 >> 10-->
                    <joint name="left_knee" type="hinge"
                           axis="0 1 0"
                           range="0.20 1.80"
                           ref="1.571"
                           springref="1.571"
                           stiffness="5" damping="2.0"/>
                      <!--changed quat to 1 0 0 0 ~ no rotation; ref provides required orientation-->
                    <geom name="left_shank_geom" type="capsule"
                          pos="0 0 -0.11"
                          size="0.020 0.11"
                          quat="1 0 0 0"
                          material="shank_mat"
                          mass="0.15" contype="1" conaffinity="1"/>

                    <body name="left_wheel_body" pos="0 0.025 -0.22">
                        <joint name="left_wheel_joint" type="hinge"
                               axis="0 1 0" damping="0.05" armature="0.05"/>

                        <geom type="cylinder" size="0.06 0.025"
                              quat="0.7071 0.7071 0 0"
                              material="wheel_mat"
                              mass="0.3" contype="1" conaffinity="1"
                              friction="1.5 0.3 0.01" pos="0 0.012 0"/>
                    </body>
                </body>
            </body>

            <!--===============================================================
            RIGHT LEG — mirror of left leg, offset −0.09 m in Y
            ===============================================================-->
            <body name="right_leg" pos="0 -0.09 0">

                <joint name="right_hip" type="hinge"
                       axis="0 1 0"
                       range="-1.20 0.40"
                       ref="-0.785"
                       damping="1.5" frictionloss="0.05"/>

                <geom name="right_thigh" type="capsule"
                      pos="0 0 -0.11"
                      size="0.022 0.11"
                      quat="1 0 0 0"
                      material="thigh_mat"
                      mass="0.20" contype="1" conaffinity="1"/>

                <body name="right_shank" pos="0 0 -0.22">

                    <joint name="right_knee" type="hinge"
                           axis="0 1 0"
                           range="0.20 1.80"
                           ref="1.571"
                           springref="1.571"
                           stiffness="5" damping="2.0"/>

                    <geom name="right_shank_geom" type="capsule"
                          pos="0 0 -0.11"
                          size="0.020 0.11"
                          quat="1 0 0 0"
                          material="shank_mat"
                          mass="0.15" contype="1" conaffinity="1"/>

                    <body name="right_wheel_body" pos="0 -0.025 -0.22">
                        <joint name="right_wheel_joint" type="hinge"
                               axis="0 1 0" damping="0.05" armature="0.05"/>

                        <geom type="cylinder" size="0.06 0.025"
                              quat="0.7071 0.7071 0 0"
                              material="wheel_mat"
                              mass="0.3" contype="1" conaffinity="1"
                              friction="1.5 0.3 0.01" pos="0 -0.012 0"/>
                    </body>
                </body>
            </body>

        </body><!-- end base -->
    </worldbody>


<!--=======================================================================
    EQUALITY CONSTRAINTS — force left/right symmetry
    ─────────────────────────────────────────────────────────────────────────
    polycoef="0 1 0 0 0" means: joint2 = joint1 exactly (1:1 coupling).
    This prevents the legs from deforming asymmetrically during yaw correction
    or from drifting apart due to physics asymmetry.
    solimp/solref tuned to be stiff but not rigid (avoids constraint explosion).
    =======================================================================-->
    <equality>
        <joint joint1="left_hip"   joint2="right_hip"  polycoef="0 1 0 0 0"
               solimp="0.9 0.95 0.001" solref="0.02 1"/>
        <joint joint1="left_knee"  joint2="right_knee" polycoef="0 1 0 0 0"
               solimp="0.9 0.95 0.001" solref="0.02 1"/>
    </equality>


    <!--=======================================================================
    ACTUATORS
    ─────────────────────────────────────────────────────────────────────────
    ctrl[] INDEX MAP  (order = exact order listed here):
      [0] left_hip_motor
      [1] right_hip_motor
      [2] left_knee_motor
      [3] right_knee_motor
      [4] left_wheel_motor
      [5] right_wheel_motor

    Gear values mirror Ascento's torque budget:
      Wheel motors : gear=30 → max 30 Nm  (balance actuators)
      Hip/knee     : gear=50 → max 50 Nm  (posture actuators)
    =======================================================================-->
    <actuator>
        <motor name="left_hip_motor"    joint="left_hip"          gear="50" ctrlrange="-1 1"/>
        <motor name="right_hip_motor"   joint="right_hip"         gear="50" ctrlrange="-1 1"/>
        <motor name="left_knee_motor"   joint="left_knee"         gear="50" ctrlrange="-1 1"/>
        <motor name="right_knee_motor"  joint="right_knee"        gear="50" ctrlrange="-1 1"/>
        <motor name="left_wheel_motor"  joint="left_wheel_joint"  gear="30" ctrlrange="-1 1"/>
        <motor name="right_wheel_motor" joint="right_wheel_joint" gear="30" ctrlrange="-1 1"/>
    </actuator>

    <!--=======================================================================
    SENSORS
    ─────────────────────────────────────────────────────────────────────────
    sensordata[] INDEX MAP:
      [0..3]  framequat  — imu_site orientation (w, x, y, z)
      [4..6]  gyro       — (roll_rate, PITCH_rate, yaw_rate) rad/s
      [7..9]  accel      — (ax, ay, az) m/s²
      [10]    left  wheel angle    (rad)
      [11]    left  wheel velocity (rad/s)
      [12]    right wheel angle    (rad)
      [13]    right wheel velocity (rad/s)
    =======================================================================-->
    <sensor>
        <framequat     name="imu_orientation"     objtype="site" objname="imu_site"/>
        <gyro          name="imu_gyro"             site="imu_site"/>
        <accelerometer name="imu_accel"            site="imu_site"/>
        <jointpos      name="left_wheel_encoder"   joint="left_wheel_joint"/>
        <jointvel      name="left_wheel_velocity"  joint="left_wheel_joint"/>
        <jointpos      name="right_wheel_encoder"  joint="right_wheel_joint"/>
        <jointvel      name="right_wheel_velocity" joint="right_wheel_joint"/>
    </sensor>

</mujoco>